# 应用配置
APP_ENV=demo
NEXT_PUBLIC_APP_NAME=MOLT

# AI 服务配置
# 可选值：claude、openai
AI_PROVIDER=claude
AI_API_URL=https://api.anthropic.com/v1/messages
AI_API_KEY=your_provider_key
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=1

# 数据库配置
DATABASE_URL=postgres://postgres:password@localhost:5432/molt

# Redis 配置
REDIS_URL=redis://localhost:6379

# Demo 模式配置
DEMO_MODE=true
DEMO_PRESET_ACCOUNT=demo_user
